rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles are readable only by their owner. All profile mutations are server-only.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /private/{document=**} { allow read, write: if false; }
    }
    // Admin SDK server routes own all writes; avoid exposing private conversations by default.
    match /chat_history/{doc} { allow read, write: if false; }
    match /active_matches/{doc} { allow read, write: if false; }
    match /_rate_limits/{doc} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
